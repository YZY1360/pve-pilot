#!/bin/bash
# PVE 管家（pve-pilot）— 服务控制入口
#
# 供 fnOS 应用中心执行 start / stop / restart / status，也可命令行手动调用：
#   cmd/main start | stop | restart | status | log [行数]
#
# 服务（nginx 透传引擎）以"daemon off"前台方式运行，进程由公共框架托管。

COMMON="$(dirname "$0")/common"
if [ -r "${COMMON}" ]; then
    . "${COMMON}"
fi

SVC_SETUP="$(dirname "$0")/service-setup"
if [ -r "${SVC_SETUP}" ]; then
    . "${SVC_SETUP}"
fi

case "$1" in
    start)
        start_daemon
        exit $?
        ;;
    stop)
        stop_daemon
        exit 0
        ;;
    restart)
        stop_daemon
        start_daemon
        exit $?
        ;;
    status)
        if daemon_status; then
            echo "${DNAME} is running"
            exit 0
        else
            echo "${DNAME} is not running"
            exit 3
        fi
        ;;
    log)
        LINES="${2:-100}"
        if [ -f "${LOG_FILE}" ]; then
            tail -n "${LINES}" "${LOG_FILE}"
            exit 0
        fi
        echo "日志文件不存在: ${LOG_FILE}"
        exit 1
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status|log [行数]}"
        exit 1
        ;;
esac
