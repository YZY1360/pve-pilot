#!/bin/bash
# ============================================================================
# PVE 管家（pve-pilot）— 应用生命周期实现（service-setup）
# ----------------------------------------------------------------------------
# 覆盖公共框架 common 中的 service_* 钩子：
#   - 安装（service_postinst）：按向导输入生成 nginx 透传配置
#   - 配置（service_postconfig）：重写配置并重启服务
#   - 启动（service_prestart）：配置缺失时按已保存设置兜底生成；手机 App 图标缺失时补全
#   - 卸载/停止（service_preuninst / service_poststop）：安全终止 nginx
#   - 升级（service_postupgrade）：恢复运行时目录，配置缺失时兜底重建；补齐手机 App 图标
#
# 运行时文件（nginx.conf / settings / logs / tmp / pid）全部位于
# ${TRIM_PKGVAR}；nginx 二进制与 mime.types 位于 ${TRIM_APPDEST}。
#
# 核心设计约束：
#   1. 根路径全量透传（PVE WebUI 不支持子目录）
#   2. Host 头必须透传（否则登录后白屏/重定向循环）
#   3. proxy_ssl_verify off（PVE 8006 为自签 HTTPS，后端不校验证书）
#   4. 0.1.7 起纯 HTTP 直连 + sub_filter 剥离 PVE 前端 JS 的 Secure cookie：
#      PVE 登录 cookie 由前端 JS 写入且硬编码 Secure 属性（proxmoxlib.js 的
#      authSet/authClear，Ext.util.Cookies.set 第 6 参数 true），浏览器只在安全
#      上下文（HTTPS）下保存。0.1.3-0.1.6 曾用同一透传端口 http→https（ssl 监听 +
#      error_page 497 重定向到 https://$host:端口），PC 浏览器可手动跳过自签证书
#      告警，但飞牛 App 内嵌 WebView 无法跳过证书校验（黑屏加载条）；0.1.7 起去掉
#      497 与 ssl 监听、纯 http 直连（http 连接无证书校验概念），并用 nginx
#      sub_filter 精确改写响应流里两处 secure 参数 true→false（sub_filter 是字节串
#      精确匹配、无正则，需带足够上下文避免误替换；缩进以 PVE 9.2.6 实测/上游
#      proxmox-widget-toolkit 源码为准：authSet 参数 20 空格、authClear 16 空格）。
#      同时 proxy_set_header Accept-Encoding "" 强制后端返回未压缩响应——PVE
#      pveproxy 对声明 gzip 的客户端会把 JS 压缩（>1024 字节），压缩字节无法被
#      sub_filter 匹配。proxy_cookie_flags ~ nosecure 保留，双保险剥离服务端
#      Set-Cookie 响应头的 Secure 标志。
#      局限：sub_filter 依赖 JS 内的精确字符串，PVE 大版本升级若改动 proxmoxlib.js
#      写法则改写失效（表现：登录后立即 401），需同步更新本文件的匹配串。
#   5. 透传端口由向导可改：配置生成后把实际端口同步写回 ${TRIM_APPDEST}/ui/config，
#      保证桌面入口 / FN Connect 指向正确端口（声明永远跟随实际）。
#   6. 手机 App 应用列表图标（ui/images/256.png）由生命周期钩子兜底补全：fnOS 升级
#      流程不会补齐新增目录（0.1.2 → 0.1.3 升级后 ui/images 缺失，手机 App 无图标；
#      Web 端用框架注册图标 ICON.PNG，升级会更新故不受影响）。升级回调与启动钩子中
#      从图标源多候选复制补齐（幂等，失败仅告警不阻塞）：优先安装目录根部的
#      ICON_256.PNG；其次框架注册目录 /var/apps/${TRIM_APPNAME}/ICON_256.PNG（实测
#      升级时 fpk 根目录图标只被提取到该目录，应用安装目录下反而没有）；最后退回
#      安装目录根部的 ICON.PNG。
# ============================================================================

# ---- 默认值（与 wizard 表单 initValue 保持一致；PVE 地址无默认值，必须由向导传入）---
PVE_ADDR_DEFAULT=""
PVE_PORT_DEFAULT="8006"
PROXY_PORT_DEFAULT="8006"

# ---- 运行时路径 --------------------------------------------------------------
NGINX_BIN="${TRIM_APPDEST}/bin/nginx"
PVE_CONF="${TRIM_PKGVAR}/nginx.conf"        # 生成的透传配置
PVE_SETTINGS="${TRIM_PKGVAR}/settings"      # 最近一次向导输入（升级/兜底恢复用）
PVE_LOG_DIR="${TRIM_PKGVAR}/logs"
PVE_TMP_DIR="${TRIM_PKGVAR}/tmp"
PVE_PID="${TRIM_PKGVAR}/nginx.pid"
PVE_CERT="${TRIM_PKGVAR}/server.crt"        # 自签 TLS 证书（0.1.7 起配置不再启用 ssl，仅保留供未来切回 https）
PVE_CERT_KEY="${TRIM_PKGVAR}/server.key"    # 自签私钥（权限 600；升级/重启保留）

# 服务启动命令：nginx 前台运行（daemon off），进程由公共框架托管
SERVICE_COMMAND="${NGINX_BIN} -c ${PVE_CONF} -e ${PVE_LOG_DIR}/error.log -g 'daemon off;'"

# ---- 输入校验 ------------------------------------------------------------------
# valid_port：校验端口为 min-max 之间的纯数字
valid_port() {
    local port="$1" min="$2" max="$3"
    case "${port}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${port}" -ge "${min}" ] 2>/dev/null && [ "${port}" -le "${max}" ] 2>/dev/null
}

# normalize_pve_addr：容忍协议前缀与路径，只保留 IP / 主机名 / [IPv6]
normalize_pve_addr() {
    local addr="$1"
    addr="${addr#https://}"
    addr="${addr#http://}"
    addr="${addr%%/*}"
    case "${addr}" in
        ''|*[!A-Za-z0-9._\-\[\]:]*) return 1 ;;
    esac
    echo "${addr}"
}

# port_in_use：检测端口是否已被监听（重启前旧服务已停止，不受本应用自身影响）
port_in_use() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "sport = :${port}" 2>/dev/null | grep -q . && return 0
        return 1
    fi
    # 无 ss 时退化为解析 /proc/net/tcp{,6}（本地端口以小端十六进制存储）
    local hex hexl
    hex=$(printf '%X' "${port}")
    hexl=$(printf '%x' "${port}")
    awk -v h="${hex}" -v hl="${hexl}" '
        NR>1 {
            split($2, a, ":");
            if (a[2] == h || a[2] == hl) { found = 1; exit }
        }
        END { exit (found ? 0 : 1) }
    ' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# ---- TLS 自签证书 ----------------------------------------------------------------
# 0.1.7 起生成的配置不再启用 ssl（纯 HTTP 直连，见头部约束 4），证书函数与证书文件
# 保留在代码中供未来切回 https 方案时使用。ensure_tls_cert 幂等生成 10 年自签证书，
# 生成失败/缺失不影响 http 透传（调用处均以 || true 守护，失败仅告警）。

# collect_local_ipv4：收集本机非回环 IPv4（SAN 覆盖"飞牛本机 IP"访问方式）
collect_local_ipv4() {
    local addrs=""
    if command -v ip >/dev/null 2>&1; then
        addrs=$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}')
    fi
    if [ -z "${addrs}" ]; then
        addrs=$(hostname -I 2>/dev/null)
    fi
    printf '%s\n' "${addrs}" | tr ' ' '\n' | cut -d/ -f1 \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
        | grep -v '^127\.' | sort -u
}

# build_san_list：生成证书 SAN（localhost / 127.0.0.1 / ::1 + 本机全部 IPv4）
build_san_list() {
    local san="DNS:localhost,IP:127.0.0.1,IP:::1"
    local ip
    for ip in $(collect_local_ipv4); do
        san="${san},IP:${ip}"
    done
    echo "${san}"
}

# ensure_tls_cert：证书缺失时用 openssl 生成 10 年自签证书（幂等）
# 生成失败不阻塞安装/启动：降级为纯 HTTP 透传并记录日志
ensure_tls_cert() {
    if [ -r "${PVE_CERT}" ] && [ -r "${PVE_CERT_KEY}" ]; then
        chmod 600 "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        return 0
    fi
    if ! command -v openssl >/dev/null 2>&1; then
        install_log "警告: 未找到 openssl，跳过自签证书生成（纯 HTTP 透传不受影响，未来切回 https 时需证书）"
        return 1
    fi
    local san
    san=$(build_san_list)
    ${RM} "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
    install_log "正在生成自签 TLS 证书（10 年有效期，SAN: ${san}）..."
    if openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 3650 \
            -keyout "${PVE_CERT_KEY}" -out "${PVE_CERT}" \
            -subj "/CN=pve-pilot" \
            -addext "subjectAltName=${san}" >/dev/null 2>&1; then
        chmod 600 "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        # 若生命周期脚本以 root 运行而服务以应用用户运行，让应用用户可读
        if [ -n "${USER:-}" ] && [ -n "${GROUP:-}" ]; then
            chown "${USER}:${GROUP}" "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        fi
        install_log "自签证书生成完成（当前纯 HTTP 透传未使用，供未来切回 https）: ${PVE_CERT}"
        return 0
    fi
    ${RM} "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
    install_log "警告: 自签证书生成失败（不影响纯 HTTP 透传，未来切回 https 方案时需重新生成）"
    return 1
}

# ---- 透传端口声明同步 ------------------------------------------------------------
# 桌面入口与 FN Connect 的端口取自安装目录下 ui/config 的 port 字段（打包默认
# 8006）。向导可改透传端口，故在配置生成后/启动钩子里把实际端口同步写回
# ${TRIM_APPDEST}/ui/config（参考 Jellyfin：声明永远跟随实际）。
# 注意：pvepilot.sc 的 src.ports/dst.ports 与 manifest 的 service_port 由平台在
# 安装/注册时读取，框架不支持应用运行时自更新 .sc，故保持打包静态值 8006；
# 若平台后续支持热更新再补充同步。
sync_ui_config_port() {
    local port="$1"
    local ui_config="${TRIM_APPDEST}/ui/config"
    [ -n "${TRIM_APPDEST:-}" ] || return 1
    if [ ! -r "${ui_config}" ]; then
        install_log "警告: 未找到 ${ui_config}，跳过桌面入口端口同步"
        return 1
    fi
    # ui/config 仅含一个 port 字段（pvepilot.Application），用 sed 改写即可（不引入 jq）
    local current
    current=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' "${ui_config}" | head -1)
    if [ -z "${current}" ]; then
        install_log "警告: ${ui_config} 中未找到 port 字段，跳过桌面入口端口同步"
        return 1
    fi
    [ "${current}" = "${port}" ] && return 0
    if sed -i "s/\"port\"[[:space:]]*:[[:space:]]*\"${current}\"/\"port\": \"${port}\"/" "${ui_config}" 2>/dev/null; then
        install_log "已同步桌面入口端口: ui/config ${current} -> ${port}"
        return 0
    fi
    install_log "警告: 同步 ${ui_config} 端口失败（无写权限？），桌面入口仍指向 ${current}"
    return 1
}

# ---- 手机 App 图标兜底补全 -----------------------------------------------------
# 手机 App 应用列表从 ${TRIM_APPDEST}/ui/images/ 读取图标（ui/config 的
# "icon": "images/{0}.png" 指向该目录，{0} 为尺寸数字）。ui/images 自 0.1.3 起才
# 随包生成，但 fnOS 升级流程不会补齐新增目录（0.1.2 → 0.1.3 升级后 images 缺失，
# 手机 App 不显示图标）。0.1.5 只补了 256.png，App 仍按需请求多个尺寸（实测本机
# 正常应用：百度网盘/影视 trim.media 为 16/24/48/64/72/96/128/256，Jellyfin 为
# 16/24/32/48/64/72/128/256），其余尺寸 404 时图标仍缺失，故取两家并集全部补齐
# （飞牛系统无 PIL / ImageMagick 不能缩放，直接把 256.png 复制为其他尺寸文件名，
# App/系统按需缩放显示，文件存在即可）。
# 源图标多候选：
#   - 优先 ${TRIM_APPDEST}/ICON_256.PNG；其次 /var/apps/${TRIM_APPNAME}/ICON_256.PNG
#     （实测：fnOS 安装/升级把 fpk 根目录的 ICON.PNG / ICON_256.PNG 提取到框架注册
#     目录，应用安装目录下反而不存在）；最后 ${TRIM_APPDEST}/ICON.PNG
#   - 各尺寸已存在则跳过（幂等；全新安装的 fpk 自带 256.png）
#   - 复制失败仅告警，不阻塞安装/启动
#   - owner 与 ui/config 保持一致（应用用户 pvepilot:pvepilot），目录/文件权限 755/644
# 注意：仅新增 ui/images 子目录与文件，不改动 ui/config，与 sync_ui_config_port 互不影响
ensure_ui_icon() {
    [ -n "${TRIM_APPDEST:-}" ] || return 1
    local ui_config="${TRIM_APPDEST}/ui/config"
    local ui_images="${TRIM_APPDEST}/ui/images"
    local ui_icon="${ui_images}/256.png"
    # 两家实测并集的全部可能请求尺寸（16/24/32/48/64/72/96/128/256.png）
    local icon_sizes=(16 24 32 48 64 72 96 128 256)

    # 256.png 缺失时才从图标源复制；已存在则跳过，只补齐其余尺寸
    # （0.1.5 → 0.1.6 升级时用户已有 256.png，但其余尺寸缺失，必须继续补齐）
    if [ ! -f "${ui_icon}" ]; then
        # 源图标多候选：应用安装目录根部、框架注册目录 /var/apps/${TRIM_APPNAME}/、再退回 ICON.PNG
        local icon_src=""
        if [ -f "${TRIM_APPDEST}/ICON_256.PNG" ]; then
            icon_src="${TRIM_APPDEST}/ICON_256.PNG"
        elif [ -n "${TRIM_APPNAME:-}" ] && [ -f "/var/apps/${TRIM_APPNAME}/ICON_256.PNG" ]; then
            icon_src="/var/apps/${TRIM_APPNAME}/ICON_256.PNG"
        elif [ -f "${TRIM_APPDEST}/ICON.PNG" ]; then
            icon_src="${TRIM_APPDEST}/ICON.PNG"
        fi
        if [ -z "${icon_src}" ]; then
            install_log "警告: 未找到 ${TRIM_APPDEST}/ICON_256.PNG、/var/apps/${TRIM_APPNAME:-}/ICON_256.PNG、${TRIM_APPDEST}/ICON.PNG，跳过手机 App 图标兜底补全"
            return 1
        fi
        if ! ${MKDIR} "${ui_images}" 2>/dev/null; then
            install_log "警告: 创建 ${ui_images} 失败，跳过手机 App 图标兜底补全"
            return 1
        fi
        if ! ${CP} "${icon_src}" "${ui_icon}" 2>/dev/null; then
            install_log "警告: 复制 ${icon_src} -> ${ui_icon} 失败，手机 App 可能不显示图标"
            return 1
        fi
    fi

    # 把 256.png 复制为其余尺寸文件名（内容相同）；已存在则跳过（幂等），
    # 复制失败仅告警不阻塞
    local size=""
    for size in "${icon_sizes[@]}"; do
        local icon_file="${ui_images}/${size}.png"
        if [ -f "${icon_file}" ]; then
            continue
        fi
        if ! ${CP} "${ui_icon}" "${icon_file}" 2>/dev/null; then
            install_log "警告: 复制 ${ui_icon} -> ${icon_file} 失败（跳过，手机 App 该尺寸可能不显示图标）"
            continue
        fi
        chmod 644 "${icon_file}" 2>/dev/null || true
    done

    chmod 755 "${ui_images}" 2>/dev/null || true
    chmod 644 "${ui_icon}" 2>/dev/null || true
    # owner 与 ui/config 保持一致（应用用户）；stat 不可用时跳过 chown（不阻塞）
    if [ -r "${ui_config}" ]; then
        local ui_owner
        ui_owner=$(stat -c '%U:%G' "${ui_config}" 2>/dev/null) \
            || ui_owner=$(stat -c '%u:%g' "${ui_config}" 2>/dev/null) || ui_owner=""
        if [ -n "${ui_owner}" ]; then
            chown "${ui_owner}" "${ui_images}" 2>/dev/null || true
            for size in "${icon_sizes[@]}"; do
                if [ -f "${ui_images}/${size}.png" ]; then
                    chown "${ui_owner}" "${ui_images}/${size}.png" 2>/dev/null || true
                fi
            done
        fi
    fi
    install_log "已补全手机 App 图标: ${ui_images}（${#icon_sizes[@]} 个尺寸）"
    return 0
}

# ---- 配置生成 ------------------------------------------------------------------
# generate_nginx_conf：按向导输入生成完整 nginx.conf
# （worker/events/http 骨架 + 透传 server 块），并持久化本次输入到 settings
generate_nginx_conf() {
    local pve_addr="$1" pve_port="$2" proxy_port="$3"

    # 1) 输入校验
    if [ -z "${pve_addr}" ]; then
        error_exit "PVE 地址不能为空：请在应用中心的安装/配置向导中填写 PVE 地址"
    fi
    pve_addr=$(normalize_pve_addr "${pve_addr}") || error_exit "PVE 地址不合法：${pve_addr}"
    valid_port "${pve_port}" 1 65535 || error_exit "PVE 端口不合法：${pve_port}（应为 1-65535）"
    valid_port "${proxy_port}" 1024 65535 || error_exit "透传端口不合法：${proxy_port}（应为 1024-65535）"

    # 2) 端口冲突检测（仅检测本地透传端口；PVE 端口在远端宿主机，本地无法检测）
    if port_in_use "${proxy_port}"; then
        error_exit "透传端口 ${proxy_port} 已被其他服务占用，请更换端口"
    fi

    # 3) IPv6 地址补方括号，供 proxy_pass 使用
    local upstream_addr="${pve_addr}"
    case "${pve_addr}" in
        *:*)
            case "${pve_addr}" in
                \[*\]) ;;
                *) upstream_addr="[${pve_addr}]" ;;
            esac
            ;;
    esac

    # 4) 运行时目录（0.1.7 起配置不再依赖 TLS 证书：纯 HTTP 直连，见头部约束 4；
    #    ensure_tls_cert 仅在启动钩子中兜底生成并保留，供未来切回 https 方案）
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true

    # 5) 生成配置（\$ 转义保留 nginx 内置变量原样写入）
    cat > "${PVE_CONF}" <<EOF
# PVE 管家（pve-pilot）nginx 透传配置
# 由安装/配置向导自动生成，请勿手动修改；如需调整请在应用中心"配置"中修改。
# 0.1.7 起为纯 HTTP 直连 + sub_filter 方案（无 ssl 监听、无 497 跳转）：
#   透传端口只监听 http（WebView/浏览器无证书校验问题）；
#   sub_filter 把 PVE 前端 JS（proxmoxlib.js authSet/authClear）写入登录 cookie 时的
#   Secure=true 改写为 false，否则 http 下浏览器拒绝保存 Secure cookie → 登录后 401。
#   局限：sub_filter 是字节串精确匹配，PVE 大版本升级若改动 JS 写法则失效（登录 401），
#   需同步更新下方 sub_filter 匹配串。

worker_processes auto;
pid ${PVE_PID};
error_log ${PVE_LOG_DIR}/error.log;

events {
    worker_connections 1024;
}

http {
    include       ${TRIM_APPDEST}/conf/mime.types;
    default_type  application/octet-stream;

    sendfile           on;
    keepalive_timeout  65;

    access_log ${PVE_LOG_DIR}/access.log;

    client_body_temp_path ${PVE_TMP_DIR}/client_body;
    proxy_temp_path       ${PVE_TMP_DIR}/proxy;

    server {
        listen       ${proxy_port};
        server_name  _;

        # PVE WebUI 固定使用根路径，必须全量透传（不支持子目录）
        location / {
            proxy_pass        https://${upstream_addr}:${pve_port};
            proxy_set_header  Host \$host;                  # 必须透传：PVE 靠 Host 头拼 URL
            proxy_set_header  X-Forwarded-Proto \$scheme;   # 透传原始协议（纯 HTTP 直连下恒为 http）
            proxy_cookie_flags ~ nosecure;                  # 双保险：剥离后端 Set-Cookie 的 Secure 标志（纯 HTTP 直连下必需）

            # 0.1.7 纯 HTTP 直连：PVE 登录 cookie 由前端 JS（proxmox-widget-toolkit
            # proxmoxlib.js 的 authSet/authClear）写入且 Secure=true 硬编码，浏览器在
            # http 下拒绝保存 → 登录后立即 401。sub_filter 把两处 secure 参数改写为
            # false（字节串精确匹配、无正则，带完整调用上下文避免误替换；缩进以 PVE
            # 9.2.6 实测/上游 pwt 源码为准：authSet 参数 20 空格、authClear 16 空格）。
            sub_filter_types application/javascript;
            sub_filter "Ext.util.Cookies.set(
                    Proxmox.Setup.auth_cookie_name,
                    data.ticket,
                    null,
                    '/',
                    null,
                    true," "Ext.util.Cookies.set(
                    Proxmox.Setup.auth_cookie_name,
                    data.ticket,
                    null,
                    '/',
                    null,
                    false,";
            sub_filter "Ext.util.Cookies.set(
                Proxmox.Setup.auth_cookie_name,
                '',
                new Date(0),
                null,
                null,
                true," "Ext.util.Cookies.set(
                Proxmox.Setup.auth_cookie_name,
                '',
                new Date(0),
                null,
                null,
                false,";
            sub_filter_once off;                            # JS 内多处出现全部替换
            # PVE pveproxy 对声明 Accept-Encoding: gzip 的客户端会把 JS 压缩（>1024
            # 字节），压缩字节无法被 sub_filter 匹配；置空该头强制后端返回未压缩响应
            proxy_set_header  Accept-Encoding "";
            proxy_http_version 1.1;
            proxy_set_header  Upgrade \$http_upgrade;       # noVNC/控制台/任务日志 = websocket
            proxy_set_header  Connection "upgrade";
            proxy_buffering   off;                          # 长连接必需
            client_max_body_size 0;                         # 上传 ISO/备份不设限
            proxy_connect_timeout 3600s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_ssl_verify  off;                          # PVE 自签证书，后端不校验证书
        }
    }
}
EOF
    chmod 644 "${PVE_CONF}" 2>/dev/null || true

    # 6) 持久化本次输入（升级/配置兜底恢复用）
    cat > "${PVE_SETTINGS}" <<EOF
PVE_ADDR=${pve_addr}
PVE_PORT=${pve_port}
PROXY_PORT=${proxy_port}
EOF
    chmod 644 "${PVE_SETTINGS}" 2>/dev/null || true

    # 7) 透传端口声明同步：桌面入口 / FN Connect 读 ui/config 的 port 字段，
    #    声明永远跟随实际端口（参考 Jellyfin；失败仅告警，不阻塞）
    sync_ui_config_port "${proxy_port}" || true
}

# load_saved_settings：从 settings 文件恢复上次输入（无文件时保持现有环境变量）
load_saved_settings() {
    if [ -r "${PVE_SETTINGS}" ]; then
        while IFS= read -r line; do
            [ -n "${line}" ] || continue
            case "${line}" in
                \#*) continue ;;
            esac
            export "${line%%=*}=${line#*=}"
        done < "${PVE_SETTINGS}"
    fi
}

# ---- 生命周期钩子实现 ------------------------------------------------------------

# 安装回调：读向导输入生成透传配置
service_postinst() {
    install_log "开始生成 nginx 透传配置（安装）"
    generate_nginx_conf \
        "${wizard_pve_addr:-${PVE_ADDR_DEFAULT}}" \
        "${wizard_pve_port:-${PVE_PORT_DEFAULT}}" \
        "${wizard_proxy_port:-${PROXY_PORT_DEFAULT}}"
    install_log "配置已生成: ${PVE_CONF}（PVE ${wizard_pve_addr:-默认}:${wizard_pve_port:-默认} -> :${wizard_proxy_port:-默认}）"
}

# 配置回调：先停止旧服务，再重写配置并重启
service_postconfig() {
    install_log "开始重写 nginx 透传配置（配置修改）"
    stop_daemon
    generate_nginx_conf \
        "${wizard_pve_addr:-${PVE_ADDR_DEFAULT}}" \
        "${wizard_pve_port:-${PVE_PORT_DEFAULT}}" \
        "${wizard_proxy_port:-${PROXY_PORT_DEFAULT}}"
    install_log "配置已更新，正在重启服务..."
    start_daemon || error_exit "服务重启失败，请查看应用日志"
}

# 启动前钩子：确保运行时目录存在；配置缺失时用已保存设置兜底生成
service_prestart() {
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true
    # 启动钩子：证书缺失时自动补生成（幂等；已存在则无操作）
    ensure_tls_cert || true
    if [ ! -f "${PVE_CONF}" ]; then
        install_log "未发现 nginx.conf，使用保存的设置兜底生成"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    elif ! grep -qF "sub_filter_types" "${PVE_CONF}" 2>/dev/null; then
        # 0.1.6 及更早版本的 nginx.conf 为 ssl 监听 + 497 跳转（或无 sub_filter），
        # 启动前重建为 0.1.7 纯 HTTP + sub_filter 方案（升级残留/降级兜底）
        install_log "检测到 0.1.6 及更早版本配置（无 sub_filter），按 0.1.7 纯 HTTP + sub_filter 方案重建"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    fi
    # 启动钩子：同步实际透传端口到 ui/config（覆盖旧版本安装留下的静态 8006）
    load_saved_settings
    sync_ui_config_port "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    # 启动钩子：手机 App 图标缺失时兜底补全（旧版升级未携带 ui/images）
    ensure_ui_icon || true
}

# 停止后钩子：兜底清理本应用数据目录下的 nginx 进程（避免误杀系统 nginx）
service_poststop() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -f "nginx.*${TRIM_PKGVAR}" 2>/dev/null || true
        sleep 1
        pkill -9 -f "nginx.*${TRIM_PKGVAR}" 2>/dev/null || true
    fi
}

# 卸载前钩子：确保 nginx 已停止
service_preuninst() {
    service_poststop
}

# 升级回调：配置/数据目录保留，确认运行时目录存在；配置缺失时兜底重建
service_postupgrade() {
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true
    # 升级回调：手机 App 图标兜底补全（fnOS 升级不补齐新增的 ui/images 目录）
    ensure_ui_icon || true
    if [ ! -f "${PVE_CONF}" ]; then
        install_log "升级后未发现配置，使用保存的设置兜底生成"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    elif ! grep -qF "sub_filter_types" "${PVE_CONF}" 2>/dev/null; then
        # 0.1.6 及更早版本的 nginx.conf 是 ssl 监听 + 497 跳转（或无 sub_filter），
        # 升级到 0.1.7 必须重建为纯 HTTP + sub_filter，否则 App WebView 黑屏
        # （自签证书无法跳过）与登录 401（Secure cookie 无法保存）依旧
        install_log "升级检测到 0.1.6 及更早版本配置（无 sub_filter），按 0.1.7 纯 HTTP + sub_filter 方案重建"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    else
        # 升级会用新包覆盖 TRIM_APPDEST/ui/config（重置为默认 8006），此处按保存的
        # 实际端口恢复桌面入口声明（nginx.conf 保留，无需重建）
        load_saved_settings
        sync_ui_config_port "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}" || true
    fi
}
