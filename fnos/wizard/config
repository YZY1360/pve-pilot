[
    {
        "stepTitle": "PVE 管家 · 配置说明",
        "items": [
            {
                "type": "tips",
                "helpText": "修改后应用会自动重写 nginx 透传配置并重启服务。<br><br>请完整填写下列三项配置（PVE 地址、PVE 端口、透传端口）。"
            }
        ]
    },
    {
        "stepTitle": "PVE 连接配置",
        "items": [
            {
                "type": "text",
                "field": "wizard_pve_addr",
                "label": "PVE 地址",
                "initValue": "192.168.8.10",
                "placeholder": "IP 或主机名，如 192.168.8.10",
                "rules": [
                    { "required": true, "message": "请输入 PVE 地址" },
                    { "pattern": "^[A-Za-z0-9._\\-\\[\\]:]+$", "message": "地址只能是 IP、主机名或 [IPv6]，请勿包含 http(s):// 前缀" }
                ]
            },
            {
                "type": "text",
                "field": "wizard_pve_port",
                "label": "PVE 端口",
                "initValue": "8006",
                "placeholder": "PVE WebUI HTTPS 端口，默认 8006",
                "rules": [
                    { "required": true, "message": "请输入 PVE 端口" },
                    { "pattern": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-5][0-9]{3})$", "message": "端口必须是 1-65535 的数字" }
                ]
            },
            {
                "type": "text",
                "field": "wizard_proxy_port",
                "label": "透传端口",
                "initValue": "8800",
                "placeholder": "飞牛本机监听端口，建议保持 8800",
                "rules": [
                    { "required": true, "message": "请输入透传端口" },
                    { "pattern": "^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-5][0-9]{3})$", "message": "透传端口必须在 1024-65535 之间" }
                ]
            }
        ]
    }
]
