#!/bin/bash
# ============================================================================
# PVE 管家（pve-pilot）— 应用生命周期实现（service-setup）
# ----------------------------------------------------------------------------
# 覆盖公共框架 common 中的 service_* 钩子：
#   - 安装（service_postinst）：按向导输入生成 nginx 透传配置
#   - 配置（service_postconfig）：重写配置并重启服务
#   - 启动（service_prestart）：配置缺失时按已保存设置兜底生成；手机 App 图标缺失时补全
#   - 卸载/停止（service_preuninst / service_poststop）：安全终止 nginx
#   - 升级（service_postupgrade）：恢复运行时目录，配置缺失时兜底重建；补齐手机 App 图标
#
# 运行时文件（nginx.conf / settings / logs / tmp / pid）全部位于
# ${TRIM_PKGVAR}；nginx 二进制与 mime.types 位于 ${TRIM_APPDEST}。
#
# 核心设计约束：
#   1. 根路径全量透传（PVE WebUI 不支持子目录）
#   2. Host 头必须透传（否则登录后白屏/重定向循环）
#   3. proxy_ssl_verify off（PVE 8006 为自签 HTTPS，后端不校验证书）
#   4. 同一透传端口同时服务 http+https（自签证书）：PVE 登录 cookie 由前端 JS
#      写入且硬编码 Secure 属性（proxmoxlib.js authSet），浏览器只在安全上下文
#      （HTTPS）下保存；HTTP 访问 301 到 HTTPS 后登录态才能持久。nginx 实测不支持
#      同 server 块内 "listen PORT ssl; listen PORT;"（1.28.3 报 duplicate listen，
#      双 server 块同端口会互相抢占导致明文 HTTP 400），故采用单一 ssl 监听 +
#      error_page 497 把明文 HTTP 请求 301 到 HTTPS（同一端口，效果等价）。
#      proxy_cookie_flags ~ nosecure 只处理服务端 Set-Cookie 响应头，对 JS 写入的
#      cookie 无效，保留仅用于剥离后端下发的 Secure 标志（双保险，纯 HTTP 降级时必需）。
#   5. 透传端口由向导可改：配置生成后把实际端口同步写回 ${TRIM_APPDEST}/ui/config，
#      保证桌面入口 / FN Connect 指向正确端口（声明永远跟随实际）。
#   6. 手机 App 应用列表图标（ui/images/256.png）由生命周期钩子兜底补全：fnOS 升级
#      流程不会补齐新增目录（0.1.2 → 0.1.3 升级后 ui/images 缺失，手机 App 无图标；
#      Web 端用框架注册图标 ICON.PNG，升级会更新故不受影响）。升级回调与启动钩子中
#      从包内 ICON_256.PNG 复制补齐（幂等，失败仅告警不阻塞）。
# ============================================================================

# ---- 默认值（与 wizard 表单 initValue 保持一致；PVE 地址无默认值，必须由向导传入）---
PVE_ADDR_DEFAULT=""
PVE_PORT_DEFAULT="8006"
PROXY_PORT_DEFAULT="8006"

# ---- 运行时路径 --------------------------------------------------------------
NGINX_BIN="${TRIM_APPDEST}/bin/nginx"
PVE_CONF="${TRIM_PKGVAR}/nginx.conf"        # 生成的透传配置
PVE_SETTINGS="${TRIM_PKGVAR}/settings"      # 最近一次向导输入（升级/兜底恢复用）
PVE_LOG_DIR="${TRIM_PKGVAR}/logs"
PVE_TMP_DIR="${TRIM_PKGVAR}/tmp"
PVE_PID="${TRIM_PKGVAR}/nginx.pid"
PVE_CERT="${TRIM_PKGVAR}/server.crt"        # 自签 TLS 证书（同一端口 http→https 用）
PVE_CERT_KEY="${TRIM_PKGVAR}/server.key"    # 自签私钥（权限 600；升级/重启保留）

# 服务启动命令：nginx 前台运行（daemon off），进程由公共框架托管
SERVICE_COMMAND="${NGINX_BIN} -c ${PVE_CONF} -e ${PVE_LOG_DIR}/error.log -g 'daemon off;'"

# ---- 输入校验 ------------------------------------------------------------------
# valid_port：校验端口为 min-max 之间的纯数字
valid_port() {
    local port="$1" min="$2" max="$3"
    case "${port}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${port}" -ge "${min}" ] 2>/dev/null && [ "${port}" -le "${max}" ] 2>/dev/null
}

# normalize_pve_addr：容忍协议前缀与路径，只保留 IP / 主机名 / [IPv6]
normalize_pve_addr() {
    local addr="$1"
    addr="${addr#https://}"
    addr="${addr#http://}"
    addr="${addr%%/*}"
    case "${addr}" in
        ''|*[!A-Za-z0-9._\-\[\]:]*) return 1 ;;
    esac
    echo "${addr}"
}

# port_in_use：检测端口是否已被监听（重启前旧服务已停止，不受本应用自身影响）
port_in_use() {
    local port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnH "sport = :${port}" 2>/dev/null | grep -q . && return 0
        return 1
    fi
    # 无 ss 时退化为解析 /proc/net/tcp{,6}（本地端口以小端十六进制存储）
    local hex hexl
    hex=$(printf '%X' "${port}")
    hexl=$(printf '%x' "${port}")
    awk -v h="${hex}" -v hl="${hexl}" '
        NR>1 {
            split($2, a, ":");
            if (a[2] == h || a[2] == hl) { found = 1; exit }
        }
        END { exit (found ? 0 : 1) }
    ' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

# ---- TLS 自签证书 ----------------------------------------------------------------
# PVE 登录 cookie 由前端 JS 写入（proxmox-widget-toolkit 的 authSet），Secure 参数
# 硬编码 true，浏览器只在安全上下文（HTTPS）下保存。因此 nginx 在同一透传端口同时
# 服务 http+https（单一 ssl 监听 + error_page 497 把明文 HTTP 301 到 HTTPS）；自签
# 证书解决本机 HTTPS 证书来源。

# collect_local_ipv4：收集本机非回环 IPv4（SAN 覆盖"飞牛本机 IP"访问方式）
collect_local_ipv4() {
    local addrs=""
    if command -v ip >/dev/null 2>&1; then
        addrs=$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $4}')
    fi
    if [ -z "${addrs}" ]; then
        addrs=$(hostname -I 2>/dev/null)
    fi
    printf '%s\n' "${addrs}" | tr ' ' '\n' | cut -d/ -f1 \
        | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' \
        | grep -v '^127\.' | sort -u
}

# build_san_list：生成证书 SAN（localhost / 127.0.0.1 / ::1 + 本机全部 IPv4）
build_san_list() {
    local san="DNS:localhost,IP:127.0.0.1,IP:::1"
    local ip
    for ip in $(collect_local_ipv4); do
        san="${san},IP:${ip}"
    done
    echo "${san}"
}

# ensure_tls_cert：证书缺失时用 openssl 生成 10 年自签证书（幂等）
# 生成失败不阻塞安装/启动：降级为纯 HTTP 透传并记录日志
ensure_tls_cert() {
    if [ -r "${PVE_CERT}" ] && [ -r "${PVE_CERT_KEY}" ]; then
        chmod 600 "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        return 0
    fi
    if ! command -v openssl >/dev/null 2>&1; then
        install_log "警告: 未找到 openssl，无法生成自签证书，降级为纯 HTTP 透传"
        return 1
    fi
    local san
    san=$(build_san_list)
    ${RM} "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
    install_log "正在生成自签 TLS 证书（10 年有效期，SAN: ${san}）..."
    if openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 3650 \
            -keyout "${PVE_CERT_KEY}" -out "${PVE_CERT}" \
            -subj "/CN=pve-pilot" \
            -addext "subjectAltName=${san}" >/dev/null 2>&1; then
        chmod 600 "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        # 若生命周期脚本以 root 运行而服务以应用用户运行，让应用用户可读
        if [ -n "${USER:-}" ] && [ -n "${GROUP:-}" ]; then
            chown "${USER}:${GROUP}" "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
        fi
        install_log "自签证书生成完成: ${PVE_CERT}"
        return 0
    fi
    ${RM} "${PVE_CERT}" "${PVE_CERT_KEY}" 2>/dev/null || true
    install_log "警告: 自签证书生成失败，降级为纯 HTTP 透传（不启用 HTTPS 重定向）"
    return 1
}

# ---- 透传端口声明同步 ------------------------------------------------------------
# 桌面入口与 FN Connect 的端口取自安装目录下 ui/config 的 port 字段（打包默认
# 8006）。向导可改透传端口，故在配置生成后/启动钩子里把实际端口同步写回
# ${TRIM_APPDEST}/ui/config（参考 Jellyfin：声明永远跟随实际）。
# 注意：pvepilot.sc 的 src.ports/dst.ports 与 manifest 的 service_port 由平台在
# 安装/注册时读取，框架不支持应用运行时自更新 .sc，故保持打包静态值 8006；
# 若平台后续支持热更新再补充同步。
sync_ui_config_port() {
    local port="$1"
    local ui_config="${TRIM_APPDEST}/ui/config"
    [ -n "${TRIM_APPDEST:-}" ] || return 1
    if [ ! -r "${ui_config}" ]; then
        install_log "警告: 未找到 ${ui_config}，跳过桌面入口端口同步"
        return 1
    fi
    # ui/config 仅含一个 port 字段（pvepilot.Application），用 sed 改写即可（不引入 jq）
    local current
    current=$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' "${ui_config}" | head -1)
    if [ -z "${current}" ]; then
        install_log "警告: ${ui_config} 中未找到 port 字段，跳过桌面入口端口同步"
        return 1
    fi
    [ "${current}" = "${port}" ] && return 0
    if sed -i "s/\"port\"[[:space:]]*:[[:space:]]*\"${current}\"/\"port\": \"${port}\"/" "${ui_config}" 2>/dev/null; then
        install_log "已同步桌面入口端口: ui/config ${current} -> ${port}"
        return 0
    fi
    install_log "警告: 同步 ${ui_config} 端口失败（无写权限？），桌面入口仍指向 ${current}"
    return 1
}

# ---- 手机 App 图标兜底补全 -----------------------------------------------------
# 手机 App 应用列表从 ${TRIM_APPDEST}/ui/images/ 读取图标（ui/config 的
# "icon": "images/{0}.png" 指向该目录）。ui/images/256.png 自 0.1.3 起才随包生成，
# 但 fnOS 升级流程不会补齐新增目录（0.1.2 → 0.1.3 升级后 images 缺失，手机 App
# 不显示图标）。此处从包内 ICON_256.PNG 复制兜底：
#   - 已存在则跳过（幂等；全新安装的 fpk 自带该文件）
#   - 复制失败仅告警，不阻塞安装/启动
#   - owner 与 ui/config 保持一致（应用用户 pvepilot:pvepilot），权限 755/644
# 注意：仅新增 ui/images 子目录与文件，不改动 ui/config，与 sync_ui_config_port 互不影响
ensure_ui_icon() {
    [ -n "${TRIM_APPDEST:-}" ] || return 1
    local ui_config="${TRIM_APPDEST}/ui/config"
    local ui_images="${TRIM_APPDEST}/ui/images"
    local ui_icon="${ui_images}/256.png"
    if [ -f "${ui_icon}" ]; then
        return 0
    fi
    if [ ! -f "${TRIM_APPDEST}/ICON_256.PNG" ]; then
        install_log "警告: 未找到 ${TRIM_APPDEST}/ICON_256.PNG，跳过手机 App 图标兜底补全"
        return 1
    fi
    if ! ${MKDIR} "${ui_images}" 2>/dev/null; then
        install_log "警告: 创建 ${ui_images} 失败，跳过手机 App 图标兜底补全"
        return 1
    fi
    if ! ${CP} "${TRIM_APPDEST}/ICON_256.PNG" "${ui_icon}" 2>/dev/null; then
        install_log "警告: 复制 ICON_256.PNG -> ${ui_icon} 失败，手机 App 可能不显示图标"
        return 1
    fi
    chmod 755 "${ui_images}" 2>/dev/null || true
    chmod 644 "${ui_icon}" 2>/dev/null || true
    # owner 与 ui/config 保持一致（应用用户）；stat 不可用时跳过 chown（不阻塞）
    if [ -r "${ui_config}" ]; then
        local ui_owner
        ui_owner=$(stat -c '%U:%G' "${ui_config}" 2>/dev/null) \
            || ui_owner=$(stat -c '%u:%g' "${ui_config}" 2>/dev/null) || ui_owner=""
        if [ -n "${ui_owner}" ]; then
            chown "${ui_owner}" "${ui_images}" "${ui_icon}" 2>/dev/null || true
        fi
    fi
    install_log "已补全手机 App 图标: ${ui_icon}"
    return 0
}

# ---- 配置生成 ------------------------------------------------------------------
# generate_nginx_conf：按向导输入生成完整 nginx.conf
# （worker/events/http 骨架 + 透传 server 块），并持久化本次输入到 settings
generate_nginx_conf() {
    local pve_addr="$1" pve_port="$2" proxy_port="$3"

    # 1) 输入校验
    if [ -z "${pve_addr}" ]; then
        error_exit "PVE 地址不能为空：请在应用中心的安装/配置向导中填写 PVE 地址"
    fi
    pve_addr=$(normalize_pve_addr "${pve_addr}") || error_exit "PVE 地址不合法：${pve_addr}"
    valid_port "${pve_port}" 1 65535 || error_exit "PVE 端口不合法：${pve_port}（应为 1-65535）"
    valid_port "${proxy_port}" 1024 65535 || error_exit "透传端口不合法：${proxy_port}（应为 1024-65535）"

    # 2) 端口冲突检测（仅检测本地透传端口；PVE 端口在远端宿主机，本地无法检测）
    if port_in_use "${proxy_port}"; then
        error_exit "透传端口 ${proxy_port} 已被其他服务占用，请更换端口"
    fi

    # 3) IPv6 地址补方括号，供 proxy_pass 使用
    local upstream_addr="${pve_addr}"
    case "${pve_addr}" in
        *:*)
            case "${pve_addr}" in
                \[*\]) ;;
                *) upstream_addr="[${pve_addr}]" ;;
            esac
            ;;
    esac

    # 4) TLS 自签证书（缺失自动生成、幂等；失败降级纯 HTTP，不阻塞安装/启动）
    #    同一透传端口同时服务 http+https：nginx 不支持同 server 块写
    #    "listen X ssl; listen X;"（实测 1.28.3 报 duplicate listen），双 server 块
    #    同端口又会被合并成单一 ssl socket、明文 HTTP 直接 400；故采用单一 ssl
    #    监听 + error_page 497（nginx 对"明文 HTTP 打到 ssl 端口"的内部错误码）
    #    把 HTTP 请求 301 到 https://$host:端口$request_uri，效果等价于同端口双协议。
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true

    local ssl_directives="" listen_addr="${proxy_port}" http_to_https_redirect=""
    if ensure_tls_cert; then
        ssl_directives="    ssl_certificate     ${PVE_CERT};
    ssl_certificate_key ${PVE_CERT_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
"
        listen_addr="${proxy_port} ssl"
        # 497 = nginx 对"明文 HTTP 请求打到 ssl 端口"的内部错误码；error_page 301
        # 到 HTTPS（\$ 转义保留 nginx 内置变量，端口用实际透传端口避免脱节）
        http_to_https_redirect="        error_page   497 =301 https://\$host:${proxy_port}\$request_uri;
"
    else
        install_log "警告: 未启用 HTTPS，降级为纯 HTTP 透传（浏览器将无法保存 PVE 的 Secure cookie）"
    fi

    # 5) 生成配置（\$ 转义保留 nginx 内置变量原样写入）
    cat > "${PVE_CONF}" <<EOF
# PVE 管家（pve-pilot）nginx 透传配置
# 由安装/配置向导自动生成，请勿手动修改；如需调整请在应用中心"配置"中修改。

worker_processes auto;
pid ${PVE_PID};
error_log ${PVE_LOG_DIR}/error.log;

events {
    worker_connections 1024;
}

http {
    include       ${TRIM_APPDEST}/conf/mime.types;
    default_type  application/octet-stream;

    sendfile           on;
    keepalive_timeout  65;

    access_log ${PVE_LOG_DIR}/access.log;

    client_body_temp_path ${PVE_TMP_DIR}/client_body;
    proxy_temp_path       ${PVE_TMP_DIR}/proxy;

${ssl_directives}
    server {
        listen       ${listen_addr};
        server_name  _;

${http_to_https_redirect}
        # PVE WebUI 固定使用根路径，必须全量透传（不支持子目录）
        location / {
            proxy_pass        https://${upstream_addr}:${pve_port};
            proxy_set_header  Host \$host;                  # 必须透传：PVE 靠 Host 头拼 URL
            proxy_set_header  X-Forwarded-Proto \$scheme;   # 透传原始协议（HTTPS 透传下恒为 https）
            proxy_cookie_flags ~ nosecure;                  # 双保险：剥离后端 Set-Cookie 的 Secure 标志（纯 HTTP 降级时必需）
            proxy_http_version 1.1;
            proxy_set_header  Upgrade \$http_upgrade;       # noVNC/控制台/任务日志 = websocket
            proxy_set_header  Connection "upgrade";
            proxy_buffering   off;                          # 长连接必需
            client_max_body_size 0;                         # 上传 ISO/备份不设限
            proxy_connect_timeout 3600s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            proxy_ssl_verify  off;                          # PVE 自签证书，后端不校验证书
        }
    }
}
EOF
    chmod 644 "${PVE_CONF}" 2>/dev/null || true

    # 6) 持久化本次输入（升级/配置兜底恢复用）
    cat > "${PVE_SETTINGS}" <<EOF
PVE_ADDR=${pve_addr}
PVE_PORT=${pve_port}
PROXY_PORT=${proxy_port}
EOF
    chmod 644 "${PVE_SETTINGS}" 2>/dev/null || true

    # 7) 透传端口声明同步：桌面入口 / FN Connect 读 ui/config 的 port 字段，
    #    声明永远跟随实际端口（参考 Jellyfin；失败仅告警，不阻塞）
    sync_ui_config_port "${proxy_port}" || true
}

# load_saved_settings：从 settings 文件恢复上次输入（无文件时保持现有环境变量）
load_saved_settings() {
    if [ -r "${PVE_SETTINGS}" ]; then
        while IFS= read -r line; do
            [ -n "${line}" ] || continue
            case "${line}" in
                \#*) continue ;;
            esac
            export "${line%%=*}=${line#*=}"
        done < "${PVE_SETTINGS}"
    fi
}

# ---- 生命周期钩子实现 ------------------------------------------------------------

# 安装回调：读向导输入生成透传配置
service_postinst() {
    install_log "开始生成 nginx 透传配置（安装）"
    generate_nginx_conf \
        "${wizard_pve_addr:-${PVE_ADDR_DEFAULT}}" \
        "${wizard_pve_port:-${PVE_PORT_DEFAULT}}" \
        "${wizard_proxy_port:-${PROXY_PORT_DEFAULT}}"
    install_log "配置已生成: ${PVE_CONF}（PVE ${wizard_pve_addr:-默认}:${wizard_pve_port:-默认} -> :${wizard_proxy_port:-默认}）"
}

# 配置回调：先停止旧服务，再重写配置并重启
service_postconfig() {
    install_log "开始重写 nginx 透传配置（配置修改）"
    stop_daemon
    generate_nginx_conf \
        "${wizard_pve_addr:-${PVE_ADDR_DEFAULT}}" \
        "${wizard_pve_port:-${PVE_PORT_DEFAULT}}" \
        "${wizard_proxy_port:-${PROXY_PORT_DEFAULT}}"
    install_log "配置已更新，正在重启服务..."
    start_daemon || error_exit "服务重启失败，请查看应用日志"
}

# 启动前钩子：确保运行时目录存在；配置缺失时用已保存设置兜底生成
service_prestart() {
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true
    # 启动钩子：证书缺失时自动补生成（幂等；已存在则无操作）
    ensure_tls_cert || true
    if [ ! -f "${PVE_CONF}" ]; then
        install_log "未发现 nginx.conf，使用保存的设置兜底生成"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    fi
    # 启动钩子：同步实际透传端口到 ui/config（覆盖旧版本安装留下的静态 8006）
    load_saved_settings
    sync_ui_config_port "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    # 启动钩子：手机 App 图标缺失时兜底补全（旧版升级未携带 ui/images）
    ensure_ui_icon || true
}

# 停止后钩子：兜底清理本应用数据目录下的 nginx 进程（避免误杀系统 nginx）
service_poststop() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -f "nginx.*${TRIM_PKGVAR}" 2>/dev/null || true
        sleep 1
        pkill -9 -f "nginx.*${TRIM_PKGVAR}" 2>/dev/null || true
    fi
}

# 卸载前钩子：确保 nginx 已停止
service_preuninst() {
    service_poststop
}

# 升级回调：配置/数据目录保留，确认运行时目录存在；配置缺失时兜底重建
service_postupgrade() {
    ${MKDIR} "${PVE_LOG_DIR}" "${PVE_TMP_DIR}" 2>/dev/null || true
    # 升级回调：手机 App 图标兜底补全（fnOS 升级不补齐新增的 ui/images 目录）
    ensure_ui_icon || true
    if [ ! -f "${PVE_CONF}" ]; then
        install_log "升级后未发现配置，使用保存的设置兜底生成"
        load_saved_settings
        generate_nginx_conf \
            "${PVE_ADDR:-${PVE_ADDR_DEFAULT}}" \
            "${PVE_PORT:-${PVE_PORT_DEFAULT}}" \
            "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}"
    else
        # 升级会用新包覆盖 TRIM_APPDEST/ui/config（重置为默认 8006），此处按保存的
        # 实际端口恢复桌面入口声明（nginx.conf 保留，无需重建）
        load_saved_settings
        sync_ui_config_port "${PROXY_PORT:-${PROXY_PORT_DEFAULT}}" || true
    fi
}
