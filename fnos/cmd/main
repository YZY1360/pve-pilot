#!/bin/bash
# PVE 管家：应用中心服务控制入口（start / stop / restart / status / log）

COMMON="$(dirname "$0")/common"
if [ -r "${COMMON}" ]; then
    . "${COMMON}"
fi

SVC_SETUP="$(dirname "$0")/service-setup"
if [ -r "${SVC_SETUP}" ]; then
    . "${SVC_SETUP}"
fi

case "$1" in
    start)
        start_daemon
        exit $?
        ;;
    stop)
        stop_daemon
        exit 0
        ;;
    restart)
        stop_daemon
        start_daemon
        exit $?
        ;;
    status)
        if daemon_status; then
            echo "${DNAME} is running"
            exit 0
        else
            echo "${DNAME} is not running"
            exit 3
        fi
        ;;
    log)
        LINES="${2:-100}"
        if [ -f "${LOG_FILE}" ]; then
            tail -n "${LINES}" "${LOG_FILE}"
            exit 0
        else
            echo "日志文件不存在: ${LOG_FILE}"
            exit 1
        fi
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status|log [行数]}"
        exit 1
        ;;
esac
